# POC always uses fictional, in-memory data.
EXPO_PUBLIC_API_MODE=demo
# Reserved for a future native Salesforce Mobile SDK build.
# These public identifiers are not credentials. Never add access tokens or secrets here.
EXPO_PUBLIC_SF_LOGIN_DOMAIN=
EXPO_PUBLIC_SF_CONSUMER_KEY=
EXPO_PUBLIC_SF_CALLBACK_URL=maidbright://oauth/callback
# Set to "backend" to log customers in through the Maid Bright backend (backend/README.md).
# Only the login is real in this mode; appointments and other screens still show demo data.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000
