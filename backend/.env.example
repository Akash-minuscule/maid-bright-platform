SF_CLIENT_ID=your_consumer_key
SF_CLIENT_SECRET=your_consumer_secret
SF_CALLBACK_URL=http://localhost:8000/oauth/callback
SF_LOGIN_URL=https://login.salesforce.com

# --- Customer login and onboarding ---
# Salesforce User ID (005...) whose /oauth/login becomes the backend's connection for the customer app.
ADMIN_SF_USER_IDS=
# 32 random bytes, base64. Encrypts the saved Salesforce refresh token. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# How verification codes are sent: console (localhost only, printed in this terminal) or salesforce (real email).
OTP_EMAIL_PROVIDER=salesforce
# Web app origins allowed to call /api/customer with cookies.
FRONTEND_ORIGINS=http://localhost:8081
# SQLite file for customer logins and sessions. Default: backend/data/maidbright.db
# MB_DB_PATH=
