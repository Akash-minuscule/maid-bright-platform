{
  "name": "maid-bright-backend",
  "version": "0.1.0",
  "description": "Maid Bright POC backend: Salesforce OAuth (authorization code + PKCE) and API connectivity",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsforce": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
